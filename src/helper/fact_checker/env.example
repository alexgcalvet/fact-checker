# fact-checker keys. `fact-checker setup` copies this file to ~/.fact-checker/.env.
# Remove the # of a line and put your key after the =. Never commit the real file.

# Speaker separation from the voices; for `chat`, also the Hugging Face key.
# HF_TOKEN=

# Published fact-checks (Google Fact Check Tools API).
# FACT_CHECK_API_KEY=

# provider = "anthropic"
# ANTHROPIC_API_KEY=

# provider = "openai" (or the variable in key_env, such as XAI_API_KEY for Grok)
# OPENAI_API_KEY=
# XAI_API_KEY=

# The figure search of a `chat` model with no web search of its own (1,000 free searches a month).
# TAVILY_API_KEY=

# Only for the project owner: reads the testers' marks with `fact-checker feedback pull`.
# FEEDBACK_ADMIN_TOKEN=
